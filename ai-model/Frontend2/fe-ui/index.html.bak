<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 분리배출 안내 서비스</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f4f9f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .container {
            background-color: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 400px;
            width: 100%;
        }
        h1 {
            color: #2e7d32;
            margin-bottom: 10px;
        }
        p {
            color: #666;
            font-size: 14px;
            margin-bottom: 30px;
        }
        .upload-btn {
            background-color: #4caf50;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
            width: 100%;
            margin-bottom: 15px;
        }
        .upload-btn:hover {
            background-color: #388e3c;
        }
        .upload-btn:disabled {
            background-color: #a5d6a7;
            cursor: not-allowed;
        }
        .sub-btn {
            background-color: #e0e0e0;
            color: #333;
            border: none;
            padding: 12px 20px;
            font-size: 14px;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
        }
        .sub-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .status-text {
            font-size: 13px;
            color: #4caf50;
            font-weight: 600;
            margin-top: 12px;
            min-height: 18px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>에코스캔 ♻️</h1>
        <p>생활폐기물 사진을 찍어서 올리면<br>AI가 올바른 분리배출 방법을 알려드립니다.</p>

        <!-- 카메라 화면으로 이동해서 바로 촬영 -->
        <button class="upload-btn" id="cameraBtn" onclick="goToCamera()">📷 사진 촬영하기</button>

        <!-- [수정] 카메라 화면을 거치지 않고, 여기서 바로 파일 선택 + 업로드 -->
        <button class="sub-btn" id="galleryBtn">🖼️ 갤러리에서 선택</button>
        <input type="file" id="galleryInput" accept="image/*" style="display: none;">

        <p class="status-text" id="statusText"></p>
    </div>

    <script>
        // FastAPI(postEx.py)를 uvicorn --port 8080으로 실행하는 것 기준
        const API_BASE = "http://localhost:8080";
        const PREDICT_URL = '/predict';

        function goToCamera() {
            window.location.href = "/fe-camera/camera.html";
        }

        const galleryBtn = document.getElementById("galleryBtn");
        const galleryInput = document.getElementById("galleryInput");
        const cameraBtn = document.getElementById("cameraBtn");
        const statusText = document.getElementById("statusText");

        galleryBtn.addEventListener("click", () => {
            galleryInput.click();
        });

        galleryInput.addEventListener("change", (event) => {
            const file = event.target.files[0];
            if (!file) return;
            uploadImage(file, file.name);
        });

        async function uploadImage(fileOrBlob, filename) {
            galleryBtn.disabled = true;
            cameraBtn.disabled = true;
            statusText.textContent = "AI가 분석하고 있어요...";

            const formData = new FormData();
            formData.append("image_file", fileOrBlob, filename);

            try {
                console.log("[index] fetch 요청 시작:", PREDICT_URL);
                const response = await fetch(PREDICT_URL, {
                    method: "POST",
                    body: formData,
                });

                console.log("[index] 응답 상태:", response.status);

                if (!response.ok) {
                    throw new Error(`서버 응답 오류: ${response.status}`);
                }

                const data = await response.json();
                console.log("[index] 예측 결과:", data);

                sessionStorage.setItem("predictResult", JSON.stringify(data));
                window.location.href = "/fe-ui/result.html";
            } catch (err) {
                // 흔한 원인: (1) predict.py 서버가 안 켜져 있음
                //           (2) index.html을 더블클릭(file://)으로 열어서 fetch가 막힘
                //           (3) API_BASE 주소가 실제 서버 주소와 다름
                console.error("[index] 업로드/예측 실패:", err);
                statusText.textContent = "";
                galleryBtn.disabled = false;
                cameraBtn.disabled = false;
                alert("분석 중 문제가 발생했어요. 콘솔(F12)에서 에러 메시지를 확인해주세요.");
            }
        }
    </script>

</body>
</html>